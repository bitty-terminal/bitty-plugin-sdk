{
  "name": "wired services provide/get/call while host-owned tasks and timers run",
  "description": "bitty #1391 (CTX-0767, LUA-OQ-8) wires bitty.services: provide registers a manifest-declared implementation during activation (undeclared interfaces fail closed with E_SERVICE_UNDECLARED), get resolves a pinned provider after activation (missing providers and unsatisfied versions fail closed with E_SERVICE_RESOLUTION, optional:true yields nil), resolved methods run with schema-validated arguments, and provider removal makes in-flight calls fail closed with E_SERVICE_GONE. Tasks and timers are WIRED: they are generation-owned, run on the virtual clock, and cancellation of spent handles returns false.",
  "manifest": "manifests/full.toml",
  "tags": ["services", "tasks", "timers", "lifecycle"],
  "steps": [
    { "op": "begin-activation" },
    {
      "op": "call",
      "surface": "services.provide",
      "args": {
        "iface": "conformance.greet",
        "impl": { "greet": { "template": "hello {name}" } }
      },
      "capture": "greet-handle"
    },
    {
      "op": "call",
      "surface": "services.provide",
      "args": {
        "iface": "undeclared.iface",
        "impl": { "ping": { "template": "pong" } }
      },
      "expect": {
        "denial": { "code": "E_SERVICE_UNDECLARED", "class": "validation" }
      }
    },
    {
      "op": "call",
      "surface": "tasks.spawn",
      "args": { "run_result": null },
      "capture": "task",
      "counter": "task-runs"
    },
    {
      "op": "call",
      "surface": "timers.create",
      "args": { "delay_ms": 100, "run_result": null },
      "capture": "timer",
      "counter": "timer-fires"
    },
    { "op": "end-activation" },
    {
      "op": "call",
      "surface": "services.get",
      "args": {
        "iface": "conformance.greet",
        "opts": { "version": ">=1.0.0" }
      },
      "capture": "greet-svc"
    },
    {
      "op": "call-service",
      "service": "greet-svc",
      "method": "greet",
      "args": { "name": "Ada" },
      "expect": { "result": "hello Ada" }
    },
    {
      "op": "call",
      "surface": "services.get",
      "args": {
        "iface": "conformance.greet",
        "opts": { "version": ">=9.9.9" }
      },
      "expect": {
        "denial": { "code": "E_SERVICE_RESOLUTION", "class": "resolution" }
      }
    },
    {
      "op": "call",
      "surface": "services.get",
      "args": {
        "iface": "missing.iface",
        "opts": { "version": ">=1.0.0" }
      },
      "expect": {
        "denial": { "code": "E_SERVICE_RESOLUTION", "class": "resolution" }
      }
    },
    {
      "op": "call",
      "surface": "services.get",
      "args": {
        "iface": "missing.iface",
        "opts": { "version": ">=1.0.0", "optional": true }
      },
      "expect": { "result": null }
    },
    { "op": "remove-service", "interface": "conformance.greet" },
    {
      "op": "call-service",
      "service": "greet-svc",
      "method": "greet",
      "args": { "name": "Ada" },
      "expect": {
        "denial": { "code": "E_SERVICE_GONE", "class": "runtime" }
      }
    },
    { "op": "drain-tasks" },
    { "op": "expect-capture", "capture": "task-runs", "value": 1 },
    { "op": "advance-time", "ms": 99 },
    { "op": "expect-capture", "capture": "timer-fires", "value": 0 },
    { "op": "advance-time", "ms": 1 },
    { "op": "expect-capture", "capture": "timer-fires", "value": 1 },
    {
      "op": "call",
      "surface": "timers.cancel",
      "args": { "handle": { "$ref": "timer" } },
      "expect": { "result": false }
    },
    {
      "op": "call",
      "surface": "tasks.cancel",
      "args": { "handle": { "$ref": "task" } },
      "expect": { "result": false }
    }
  ]
}
