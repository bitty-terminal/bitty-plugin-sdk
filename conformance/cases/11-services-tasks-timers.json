{
  "name": "deferred services fail closed while host-owned tasks and timers run",
  "description": "bitty #1303 (CTX-0707) defers bitty.services: provide and get stay present but fail closed with typed E_NOT_IMPLEMENTED (runtime) before version, optionality, or declaration checks run, so no provider ever resolves and no service call is reachable. The manifest [services.provided] declaration stays valid accepted-contract metadata. Tasks and timers are WIRED: they are generation-owned, run on the virtual clock, and cancellation of spent handles returns false.",
  "manifest": "manifests/full.toml",
  "tags": ["services", "tasks", "timers", "lifecycle", "pending-host"],
  "steps": [
    { "op": "begin-activation" },
    {
      "op": "call",
      "surface": "services.provide",
      "args": {
        "iface": "conformance.greet",
        "impl": { "greet": { "template": "hello {name}" } }
      },
      "expect": {
        "denial": { "code": "E_NOT_IMPLEMENTED", "class": "runtime" }
      }
    },
    {
      "op": "call",
      "surface": "tasks.spawn",
      "args": { "run_result": null },
      "capture": "task",
      "counter": "task-runs"
    },
    {
      "op": "call",
      "surface": "timers.create",
      "args": { "delay_ms": 100, "run_result": null },
      "capture": "timer",
      "counter": "timer-fires"
    },
    { "op": "end-activation" },
    {
      "op": "call",
      "surface": "services.get",
      "args": {
        "iface": "conformance.greet",
        "opts": { "version": ">=1.0.0" }
      },
      "expect": {
        "denial": { "code": "E_NOT_IMPLEMENTED", "class": "runtime" }
      }
    },
    {
      "op": "call",
      "surface": "services.get",
      "args": { "iface": "conformance.greet" },
      "expect": {
        "denial": { "code": "E_NOT_IMPLEMENTED", "class": "runtime" }
      }
    },
    {
      "op": "call",
      "surface": "services.get",
      "args": {
        "iface": "conformance.greet",
        "opts": { "version": ">=1.0.0", "optional": true }
      },
      "expect": {
        "denial": { "code": "E_NOT_IMPLEMENTED", "class": "runtime" }
      }
    },
    { "op": "drain-tasks" },
    { "op": "expect-capture", "capture": "task-runs", "value": 1 },
    { "op": "advance-time", "ms": 99 },
    { "op": "expect-capture", "capture": "timer-fires", "value": 0 },
    { "op": "advance-time", "ms": 1 },
    { "op": "expect-capture", "capture": "timer-fires", "value": 1 },
    {
      "op": "call",
      "surface": "timers.cancel",
      "args": { "handle": { "$ref": "timer" } },
      "expect": { "result": false }
    },
    {
      "op": "call",
      "surface": "tasks.cancel",
      "args": { "handle": { "$ref": "task" } },
      "expect": { "result": false }
    }
  ]
}
