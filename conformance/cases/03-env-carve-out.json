{
  "name": "env deferred: present when declared but every call fails with E_NOT_IMPLEMENTED",
  "description": "bitty #1303 (CTX-0707) defers bitty.env: the namespace stays present when the manifest declares env capabilities (and absent otherwise), but every call fails closed with typed E_NOT_IMPLEMENTED (runtime) until the host backend lands. Grants, allowlists, and key shapes change nothing: the deferred gate runs before capability and validation checks. The ADR 0006 allowlist behavior returns when the namespace wires.",
  "manifest": "manifests/env-declared.toml",
  "tags": ["env", "deny-by-default", "capability", "pending-host"],
  "environment": {
    "FIXTURE_KEY_ONE": "value-one",
    "FIXTURE_KEY_TWO": "value-two",
    "BITTY_THEME": "dark",
    "OTHER": "other"
  },
  "steps": [
    { "op": "begin-activation" },
    { "op": "expect-bitty-env", "present": true },
    {
      "op": "call",
      "surface": "env.get",
      "args": { "name": "FIXTURE_KEY_ONE" },
      "expect": {
        "denial": { "code": "E_NOT_IMPLEMENTED", "class": "runtime" }
      }
    },
    { "op": "grant", "capability": "env:FIXTURE_KEY_ONE" },
    { "op": "grant", "capability": "env:BITTY_*" },
    {
      "op": "call",
      "surface": "env.get",
      "args": { "name": "FIXTURE_KEY_ONE" },
      "expect": {
        "denial": { "code": "E_NOT_IMPLEMENTED", "class": "runtime" }
      }
    },
    {
      "op": "call",
      "surface": "env.get",
      "args": { "name": "BITTY_THEME" },
      "expect": {
        "denial": { "code": "E_NOT_IMPLEMENTED", "class": "runtime" }
      }
    },
    {
      "op": "call",
      "surface": "env.has",
      "args": { "name": "FIXTURE_KEY_ONE" },
      "expect": {
        "denial": { "code": "E_NOT_IMPLEMENTED", "class": "runtime" }
      }
    },
    {
      "op": "call",
      "surface": "env.get",
      "args": { "name": "lowercase" },
      "expect": {
        "denial": { "code": "E_NOT_IMPLEMENTED", "class": "runtime" }
      }
    }
  ]
}
