{
  "name": "First-party/third-party parity denial (third-party)",
  "description": "W-103 S-2 parity proof, third-party leg: a third-party composer clone (example.composer-clone) sees the identical denials and success shapes as the first-party leg. Steps are byte-identical to 26-parity-denial-first-party.json; only the manifest differs.",
  "manifest": "manifests/composer-thirdparty.toml",
  "tags": ["capability", "deny-by-default", "parity", "terminal", "ui"],
  "grants": [],
  "environment": { "VISUAL": "vim" },
  "steps": [
    { "op": "begin-activation" },
    {
      "op": "call",
      "surface": "terminal.submit",
      "args": { "text": "hi" },
      "expect": {
        "denial": { "code": "E_CAPABILITY_DENIED", "class": "runtime" }
      }
    },
    {
      "op": "call",
      "surface": "process.editor.start",
      "args": {},
      "expect": {
        "denial": { "code": "E_CAPABILITY_DENIED", "class": "runtime" }
      }
    },
    {
      "op": "call",
      "surface": "ui.overlay.acquire",
      "args": { "spec": { "title": "parity" } },
      "expect": {
        "denial": { "code": "E_CAPABILITY_DENIED", "class": "runtime" }
      }
    },
    { "op": "grant", "capability": "terminal.input.submit" },
    { "op": "grant", "capability": "process.editor" },
    { "op": "grant", "capability": "ui.overlay.focus" },
    {
      "op": "call",
      "surface": "terminal.submit",
      "args": { "text": "hi" },
      "expect": { "result": { "status": "accepted", "bytes": 15 } }
    },
    {
      "op": "call",
      "surface": "process.editor.start",
      "args": {},
      "expect": { "result": { "status": "cancelled" } }
    },
    {
      "op": "call",
      "surface": "ui.overlay.acquire",
      "args": { "spec": { "title": "parity" } },
      "capture": "h1"
    },
    {
      "op": "call",
      "surface": "ui.overlay.release",
      "args": { "handle": { "$ref": "h1" }, "reason": "cancelled" },
      "expect": { "result": true }
    },
    { "op": "end-activation" }
  ]
}
