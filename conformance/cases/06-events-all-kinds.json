{
  "name": "closed v1 event set round-trips with sequences and immutable payloads",
  "description": "Every kind in the closed 17-name v1 set is subscribed and published once; each handler receives the frozen envelope with the host-assigned monotonic sequence and the exact bounded payload.",
  "manifest": "manifests/full.toml",
  "tags": ["events", "round-trip"],
  "steps": [
    {
      "op": "begin-activation"
    },
    {
      "op": "subscribe",
      "event": "plugin.activated",
      "capture": "ev-plugin.activated"
    },
    {
      "op": "subscribe",
      "event": "plugin.suspended",
      "capture": "ev-plugin.suspended"
    },
    {
      "op": "subscribe",
      "event": "plugin.disposed",
      "capture": "ev-plugin.disposed"
    },
    {
      "op": "subscribe",
      "event": "handler.violation",
      "capture": "ev-handler.violation"
    },
    {
      "op": "subscribe",
      "event": "terminal.opened",
      "capture": "ev-terminal.opened"
    },
    {
      "op": "subscribe",
      "event": "terminal.closed",
      "capture": "ev-terminal.closed"
    },
    {
      "op": "subscribe",
      "event": "terminal.title-changed",
      "capture": "ev-terminal.title-changed"
    },
    {
      "op": "subscribe",
      "event": "terminal.cwd-changed",
      "capture": "ev-terminal.cwd-changed"
    },
    {
      "op": "subscribe",
      "event": "terminal.bell",
      "capture": "ev-terminal.bell"
    },
    {
      "op": "subscribe",
      "event": "focus.changed",
      "capture": "ev-focus.changed"
    },
    {
      "op": "subscribe",
      "event": "selection.changed",
      "capture": "ev-selection.changed"
    },
    {
      "op": "subscribe",
      "event": "process.exited",
      "capture": "ev-process.exited"
    },
    {
      "op": "subscribe",
      "event": "config.reloaded",
      "capture": "ev-config.reloaded"
    },
    {
      "op": "subscribe",
      "event": "intercept.command-dispatch",
      "capture": "ev-intercept.command-dispatch"
    },
    {
      "op": "subscribe",
      "event": "intercept.terminal-spawn",
      "capture": "ev-intercept.terminal-spawn"
    },
    {
      "op": "subscribe",
      "event": "intercept.paste",
      "capture": "ev-intercept.paste"
    },
    {
      "op": "subscribe",
      "event": "intercept.open-url",
      "capture": "ev-intercept.open-url"
    },
    {
      "op": "publish",
      "event": "plugin.activated",
      "payload": {},
      "expect": {
        "result": {
          "delivered": 1,
          "vetoed": false
        }
      }
    },
    {
      "op": "publish",
      "event": "plugin.suspended",
      "payload": {},
      "expect": {
        "result": {
          "delivered": 1,
          "vetoed": false
        }
      }
    },
    {
      "op": "publish",
      "event": "plugin.disposed",
      "payload": {},
      "expect": {
        "result": {
          "delivered": 1,
          "vetoed": false
        }
      }
    },
    {
      "op": "publish",
      "event": "handler.violation",
      "payload": {},
      "expect": {
        "result": {
          "delivered": 1,
          "vetoed": false
        }
      }
    },
    {
      "op": "publish",
      "event": "terminal.opened",
      "payload": {
        "terminal_id": 1,
        "runtime_id": 2,
        "generation": 1
      },
      "expect": {
        "result": {
          "delivered": 1,
          "vetoed": false
        }
